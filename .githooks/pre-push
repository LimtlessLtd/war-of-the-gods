#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
# both guards read the outgoing refs from stdin, so keep a copy
refs=$(cat)
for candidate in python3 python; do
    if "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
        printf '%s\n' "$refs" | "$candidate" "$root/scripts/check_no_videos.py" pre-push
        printf '%s\n' "$refs" | "$candidate" "$root/scripts/check_public_paths.py" pre-push
        exit 0
    fi
done
echo 'Push blocked: Python 3.9 or newer is required by the repository guards.' >&2
exit 1
